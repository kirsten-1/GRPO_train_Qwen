# Open-R1 native GRPO config for Stage1 (vLLM server mode).
# Use with: accelerate launch ... /root/grpo/open-r1/src/open_r1/grpo.py --config /root/grpo/stage1/openr1_stage1_grpo_server.yaml

# Model arguments
model_name_or_path: /root/autodl-tmp/models/Qwen/Qwen2___5-3B-Instruct
model_revision: main
trust_remote_code: true
torch_dtype: bfloat16
attn_implementation: flash_attention_2

# Dataset arguments (local directory prepared by prepare_stage1_openr1_dataset.py)
dataset_name: /root/autodl-tmp/training_data/stage1_openr1_dataset
dataset_train_split: train
dataset_prompt_column: problem
system_prompt: "You are a helpful AI Assistant. Think step by step, then answer in this format: <think>\\n...\\n</think>\\n<answer>\\n...\\n</answer>"

# GRPO trainer arguments
use_vllm: true
vllm_mode: server
vllm_server_host: 127.0.0.1
vllm_server_port: 8000
vllm_server_timeout: 240.0
do_eval: false

num_train_epochs: 1
per_device_train_batch_size: 1
gradient_accumulation_steps: 2
learning_rate: 2.0e-5
warmup_ratio: 0.1
lr_scheduler_type: cosine

num_generations: 2
beta: 0.02
temperature: 0.7
max_prompt_length: 1024
max_completion_length: 256

bf16: true
gradient_checkpointing: true
gradient_checkpointing_kwargs:
  use_reentrant: false

logging_strategy: steps
logging_steps: 1
logging_first_step: true
save_strategy: epoch
save_total_limit: 2
report_to:
  - tensorboard

output_dir: /root/autodl-tmp/stage1_grpo_runs/openr1_stage1_server
overwrite_output_dir: false
push_to_hub: false
seed: 42

# Open-R1 reward registry
reward_funcs:
  - accuracy
  - format
  - tag_count
reward_weights:
  - 1.0
  - 0.2
  - 0.1
